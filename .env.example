# BOBO4J configuration template. Copy to .env; never commit real credentials.
# Docker: pass this repository's .env using --env-file from the frontend directory.
# Local JVM: load .env into each process environment; Spring does not load it automatically.
WEB_PORT=5173
GATEWAY_PORT=18000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agent
MYSQL_USERNAME=agent
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-redis-me
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_IDENTITY_KEY=agent
NACOS_AUTH_IDENTITY_VALUE=change-identity
NACOS_AUTH_TOKEN=

# Generate independent keys. AES: Base64 of 32 random bytes.
# Internal HMAC key ring: current=BASE64_OF_32_RANDOM_BYTES.
API_KEY_ENCRYPTION_KEY=
INTERNAL_PRINCIPAL_SECRETS=
INTERNAL_PRINCIPAL_ACTIVE_KEY_ID=current
# Generate an independent secret of at least 32 characters for email OTP.
AUTH_OTP_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
FORCE_COOKIE_SECURE=false

# Operator model credentials are consumed by Auth, not the browser.
PLATFORM_API_KEY=
PLATFORM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLATFORM_CHAT_MODEL=qwen-turbo
PLATFORM_VISION_MODEL=qwen-vl-plus
PLATFORM_IMAGE_MODEL=qwen-image-3.0-pro
PLATFORM_EMBEDDING_MODEL=text-embedding-v4
PLATFORM_RERANK_MODEL=qwen3-rerank
# Use the actual regional/workspace rerank base; client appends /reranks.
PLATFORM_RERANK_BASE_URL=
PLATFORM_EVALUATION_MODEL=qwen-plus
PLATFORM_FALLBACK_MODEL=qwen-plus
PLATFORM_FALLBACK_PROVIDER=QWEN
PLATFORM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Blank fallback API key reuses PLATFORM_API_KEY.
PLATFORM_FALLBACK_API_KEY=
MODEL_FIRST_OUTPUT_TIMEOUT_SECONDS=15
MODEL_IDLE_TIMEOUT_SECONDS=20
MODEL_TOTAL_TIMEOUT_SECONDS=60
MODEL_FALLBACK_TIMEOUT_SECONDS=30
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
RAG_STORAGE_ROOT=./data/rag
RAG_DENSE_RRF_WEIGHT=1.0
RAG_RERANK_MINIMUM=0.25
TRACE_SAMPLING_PROBABILITY=0.1

# OSS: Media and Content receive these values through Docker Compose.
OSS_ENABLED=false
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# QQ mailbox: use the SMTP authorization code, not the login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
SMTP_STARTTLS=false

# Example prices; confirm operator policy before production.
# 1 CNY = 1000000 micros; recharge orders use amountCents (integer cents).
BILLING_TOKEN_PRICE_PER_1K_MICROS=10000
BILLING_TEXT_RESERVE_MICROS=200000
BILLING_IMAGE_PRICE_MICROS=1000000
BILLING_LOW_BALANCE_MICROS=500000
BILLING_ADMIN_USER_IDS=
BILLING_PLATFORM_FAULT_ENABLED=false
BILLING_PLATFORM_FAULT_GROUP_CAP_MICROS=400000
BILLING_PLATFORM_FAULT_WINDOW_CAP_MICROS=2000000
BILLING_PLATFORM_FAULT_UNRESOLVED_CAP=10

# Public HTTPS origin without trailing slash, e.g. https://bobo.example.com.
PAYMENT_NOTIFY_BASE_URL=
# Relative to backend docker-compose.app.yml; mounted read-only into Auth.
PAYMENT_KEYS_DIR=./secrets/payments
ALIPAY_ENABLED=false
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=/run/payment-keys/alipay-private.pem
ALIPAY_PUBLIC_KEY_PATH=/run/payment-keys/alipay-public.pem
WECHAT_PAY_ENABLED=false
WECHAT_APP_ID=
WECHAT_MERCHANT_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=/run/payment-keys/wechat-private.pem
WECHAT_API_V3_KEY=
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=/run/payment-keys/wechat-public.pem
