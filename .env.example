# Public, synthetic template. Copy to .env and supply private credentials locally.
# Default local startup is not production. Use production only after replacing
# every local credential, setting HTTPS CORS origins and enabling secure cookies.
APP_ACTIVE_PROFILES=local
INFRA_BIND_ADDRESS=127.0.0.1
GATEWAY_BIND_ADDRESS=127.0.0.1
MYSQL_DATABASE=agent
MYSQL_USERNAME=agent
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
REDIS_PASSWORD=change-redis-me
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_IDENTITY_KEY=agent
NACOS_AUTH_IDENTITY_VALUE=agent-local
NACOS_AUTH_TOKEN=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Generate separate random keys; never use these known local values in production.
INTERNAL_PRINCIPAL_ACTIVE_KEY_ID=current
INTERNAL_PRINCIPAL_SECRETS=current=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
API_KEY_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
API_KEY_ENCRYPTION_KEYS=
API_KEY_ACTIVE_KEY_ID=current
AUTH_OTP_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
FORCE_COOKIE_SECURE=false
SESSION_COOKIE_NAME=bbb_agent_session
DEFAULT_TENANT_ID=local

# Auth owns platform models. Blank API keys deliberately disable real model calls.
PLATFORM_PROVIDER=GPT
PLATFORM_BASE_URL=https://api.openai.com/v1
PLATFORM_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
PLATFORM_QWEN_API_KEY=
PLATFORM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLATFORM_CHAT_MODEL=gpt-4.1
PLATFORM_VISION_MODEL=gpt-4.1
PLATFORM_IMAGE_MODEL=qwen-image-3.0-pro
PLATFORM_EMBEDDING_MODEL=text-embedding-v4
PLATFORM_RERANK_MODEL=qwen3-rerank
PLATFORM_RERANK_BASE_URL=
PLATFORM_EVALUATION_MODEL=gpt-4.1
PLATFORM_FALLBACK_PROVIDER=QWEN
PLATFORM_FALLBACK_MODEL=qwen-plus
PLATFORM_VISION_FALLBACK_MODEL=qwen-vl-plus
PLATFORM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLATFORM_FALLBACK_API_KEY=

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
SMTP_STARTTLS=false
OSS_ENABLED=false
ALIYUN_OSS_REGION=cn-beijing
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
OSS_ARCHIVE_PREFIX=one and one
MILVUS_TOKEN=
TRACE_SAMPLING_PROBABILITY=0.1

ALIPAY_ENABLED=false
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
PAYMENT_NOTIFY_BASE_URL=
PAYMENT_KEYS_DIR=./secrets/payments
ALIPAY_PRIVATE_KEY_PATH=/run/payment-keys/alipay-private.pem
ALIPAY_PUBLIC_KEY_PATH=/run/payment-keys/alipay-public.pem

# Monitoring defaults use checked-in files and a no-op notification receiver.
# Override with ABSOLUTE private host paths; see infra/README.md before enabling.
# ALERTMANAGER_CONFIG_FILE=/absolute/private/alertmanager.yml
# ALERTMANAGER_SECRETS_DIR=/absolute/private/secrets
# OPERATIONS_TARGETS_FILE=/absolute/private/operations-targets.yml
# OPERATIONS_HOST_GATEWAY=172.20.0.1
