# Public model-routing template. Supply credentials through deployment secrets or process env.
# Copy selected values into your private deployment environment; never commit populated keys.
PLATFORM_PROVIDER=GPT
PLATFORM_BASE_URL=https://api.openai.com/v1
PLATFORM_CHAT_MODEL=gpt-4.1
PLATFORM_VISION_MODEL=gpt-4.1
PLATFORM_EVALUATION_MODEL=gpt-4.1
OPENAI_API_KEY=

PLATFORM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
PLATFORM_IMAGE_MODEL=qwen-image-3.0-pro
PLATFORM_EMBEDDING_MODEL=text-embedding-v4
PLATFORM_RERANK_MODEL=qwen3-rerank
# Set the workspace-compatible API URL supplied by your provider for reranking.
PLATFORM_RERANK_BASE_URL=
PLATFORM_FALLBACK_PROVIDER=QWEN
PLATFORM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLATFORM_FALLBACK_MODEL=qwen-plus
PLATFORM_VISION_FALLBACK_MODEL=qwen-vl-plus
PLATFORM_FALLBACK_API_KEY=

VISION_MEMORY_DIMENSIONS=1024
VISION_MEMORY_SIMILARITY_THRESHOLD=0.55
GATEWAY_TRAFFIC_ENABLED=true
GATEWAY_ROUTE_QPS=50
GATEWAY_RATE_INTERVAL_SECONDS=1
GATEWAY_IMAGE_QPS=20
GATEWAY_DOCUMENT_QPS=20
GATEWAY_EXECUTION_QPS=30

# Optional gallery (administrator platform cost). See docs/prompt-gallery.md.
PROMPT_GALLERY_ENABLED=false
PROMPT_GALLERY_CHAT_ENABLED=false
