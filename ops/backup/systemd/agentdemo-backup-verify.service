[Unit]
Description=Isolated AgentDemo backup restoration drill
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
# Backup runner updates the object pointer only after validated upload and retention.
ExecStart=/bin/sh /opt/agentdemo/backup/verify-selected.sh
SuccessExitStatus=75
TimeoutStartSec=3h
TimeoutStopSec=90
KillMode=control-group
Nice=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/agentdemo/backup /var/lib/agentdemo-backup /run/lock/agentdemo-backup
StandardOutput=journal
StandardError=journal
