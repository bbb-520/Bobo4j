[Unit]
Description=Encrypted AgentDemo offsite backup
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/agentdemo/backup/backup.py backup --config /etc/agentdemo-backup/config.json
SuccessExitStatus=75
TimeoutStartSec=3h
TimeoutStopSec=90
KillMode=control-group
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/agentdemo/backup /var/lib/agentdemo-backup /run/lock/agentdemo-backup
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
