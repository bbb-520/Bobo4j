# 镜像构建使用非 root 用户、Temurin 21 JRE 和 MaxRAMPercentage=75。
# 通过 JAR_FILE 参数选择要打包进镜像的微服务 JAR。

FROM eclipse-temurin:21-jre
ARG JAR_FILE
WORKDIR /app
RUN addgroup --system app && adduser --system --home /app --ingroup app app && mkdir -p /app/logs && chown app:app /app /app/logs
COPY ${JAR_FILE} app.jar
RUN chown app:app app.jar
USER app
ENV HOME="/app"
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
# Each service supplies its own SERVER_PORT through Compose or the environment.
EXPOSE 18000 18081 18082 18083 18084 18085 18086
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=12 CMD curl -fsS "http://127.0.0.1:${SERVER_PORT}/actuator/health/readiness" || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
